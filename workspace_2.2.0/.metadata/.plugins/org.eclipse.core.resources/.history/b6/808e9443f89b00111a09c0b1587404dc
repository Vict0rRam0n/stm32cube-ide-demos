  {
    return (-1);
  }
  else
  {
    printf("GPIO Init Done\r\n");
    //vTaskStartScheduler();
    //app_synctasks_init();
    
    while (1) {

    }
  }
} /* end main */

int _write(int file, char *ptr, int len)
{
  (void)file;
 
  for (int i = 0; i < len; i++)
  {
    ITM_SendChar(*ptr++);
  }
  return len;
}
 
void ITM_SendValue(int port, int32_t value)
{
  if ((CoreDebug->DEMCR & CoreDebug_DEMCR_TRCENA_Msk) &&
      (ITM->TCR & ITM_TCR_ITMENA_Msk) &&
      (ITM->TER & (1UL << port)))
  {
    ITM->PORT[port].u32 = (uint32_t)value;
  }
}
